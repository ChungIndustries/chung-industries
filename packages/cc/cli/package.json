{
  "name": "cli",
  "version": "0.0.3",
  "private": true,
  "description": "A library for building command-line interfaces on CC:Tweaked.",
  "author": "chungindustries",
  "scripts": {
    "lint:lua": "luacheck src tests",
    "format:lua": "stylua src tests",
    "format:lua:check": "stylua --check src tests",
    "test:lua": "lua tests/run.lua"
  },
  "nx": {
    "tags": [
      "lang:lua",
      "scope:cpm"
    ],
    "implicitDependencies": [
      "cpm-tool"
    ],
    "targets": {
      "build": {
        "command": "go run ./cmd/cpm pack --dir ../../{projectRoot}",
        "options": {
          "cwd": "apps/cpm-tool",
          "forwardAllArgs": false
        }
      },
      "publish:registry": {
        "command": "go run ./cmd/cpm publish --dir ../../{projectRoot}",
        "options": {
          "cwd": "apps/cpm-tool",
          "forwardAllArgs": false
        }
      }
    }
  }
}
