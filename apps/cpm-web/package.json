{
  "name": "cpm-web",
  "version": "0.0.0",
  "private": true,
  "description": "Website for the official CPM registry: browse, search, and learn how to install cpm packages.",
  "author": "chrille0313",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy -c dist/cpm_web/wrangler.json",
    "gen-routes": "tsr generate",
    "gen-types": "wrangler types --include-runtime=false",
    "verify-generated": "pnpm gen-types && git diff --ignore-space-at-eol --exit-code -- worker-configuration.d.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "pnpm gen-routes && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.31",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@workspace/ui": "workspace:*",
    "hono": "^4.13.3",
    "lucide-react": "^1.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semver": "^7.7.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260828.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/router-cli": "^1.167.0",
    "@total-typescript/tsconfig": "^1.0.4",
    "@tanstack/router-plugin": "^1.167.12",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@workspace/lint-config": "workspace:*",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.127.1"
  }
}
