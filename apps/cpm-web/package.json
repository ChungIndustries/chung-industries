{
  "name": "cpm-web",
  "version": "0.0.2",
  "private": true,
  "description": "Website for the official CPM registry: browse, search, and learn how to install cpm packages.",
  "author": "chrille0313",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "gen-routes": "tsr generate",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "pnpm gen-routes && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@better-auth/api-key": "1.7.2",
    "better-auth": "1.7.2",
    "@tanstack/react-form": "^1.28.6",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "^5.102.0",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.49",
    "@workspace/hooks": "workspace:*",
    "@workspace/ui": "workspace:*",
    "lucide-react": "^1.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "semver": "^7.7.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/router-cli": "^1.167.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@workspace/lint-config": "workspace:*",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.127.1"
  }
}
