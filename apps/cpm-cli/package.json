{
  "name": "cpm-cli",
  "version": "0.0.4",
  "private": true,
  "description": "The cpm package manager client for CC:Tweaked computers.",
  "author": "chungindustries",
  "scripts": {
    "lint:lua": "luacheck src",
    "format:lua": "stylua src",
    "format:lua:check": "stylua --check src"
  },
  "devDependencies": {
    "cli": "workspace:*"
  },
  "nx": {
    "tags": [
      "lang:lua",
      "scope:cpm"
    ],
    "implicitDependencies": [
      "cpm-tool"
    ],
    "targets": {
      "build": {
        "command": "go run ./cmd/cpm pack --dir ../../{projectRoot}",
        "options": {
          "cwd": "apps/cpm-tool",
          "forwardAllArgs": false
        }
      },
      "publish:registry": {
        "command": "go run ./cmd/cpm publish --dir ../../{projectRoot}",
        "options": {
          "cwd": "apps/cpm-tool",
          "forwardAllArgs": false
        }
      }
    }
  }
}
